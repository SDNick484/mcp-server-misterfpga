#!/sbin/openrc-run
# OpenRC service for the MiSTer play tracker: what each MiSTer plays, published to
# Home Assistant over MQTT (src/misterfpga_mcp/track.py). Installed as
# /etc/init.d/mcp-server-misterfpga-track by install.sh, next to the MCP service.
# Same user, same files: the MiSTers from /var/lib/mcp-server-misterfpga/config.json,
# the broker from MISTERFPGA_MQTT_* in /etc/mcp-server-misterfpga/env. Its own
# track-state.json (in /var/lib) remembers the last session it published.

name="mcp-server-misterfpga-track"
description="MiSTer play tracker for Home Assistant (MQTT)"

supervisor="supervise-daemon"
command="/opt/mcp-server-misterfpga/run.sh"
command_args="track"
command_user="mcp-mister:mcp-mister"
directory="/var/lib/mcp-server-misterfpga"
output_log="/var/log/mcp-server-misterfpga/track.log"
error_log="/var/log/mcp-server-misterfpga/track.log"
respawn_delay=5
respawn_max=10
respawn_period=300

depend() {
	need net
	after firewall
}

start_pre() {
	checkpath --directory --mode 0750 --owner mcp-mister:mcp-mister /var/log/mcp-server-misterfpga
	checkpath --directory --mode 0700 --owner mcp-mister:mcp-mister /var/lib/mcp-server-misterfpga
}
