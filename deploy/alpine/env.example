# /etc/mcp-server-misterfpga/env: read by run.sh (root:mcp-mister, mode 0640).
# Plain KEY=value lines. The MiSTers, their SSH key and backup_dir are in
# /var/lib/mcp-server-misterfpga/config.json (written by `check`).
# After changing it: rc-service mcp-server-misterfpga restart

# --- HTTP and Cloudflare Access (the service) -------------------------------------------
# Where the service listens. 127.0.0.1 when cloudflared runs in this same container or
# machine (recommended); this machine's LAN address if cloudflared runs elsewhere (then
# Access is required). Without CF_ACCESS_* it serves only requests that start on this
# machine, and answers 403 to anything a tunnel forwards (src/misterfpga_mcp/remote.py).
# Never --insecure-no-auth here: this server can start an update that reboots a MiSTer,
# and its SSH key is root on them (README, "Remote access").
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8716
MCP_HTTP_PATH=/misterfpga/mcp
# The public hostname Cloudflare forwards (Host header checks).
#MCP_PUBLIC_HOSTS=mcp.example.com

# Cloudflare Access: the team domain and the Access application's AUD tag. Every request
# must then carry a valid Access assertion, checked here as well as at Cloudflare's edge.
#CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
#CF_ACCESS_AUD=<the Access application's AUD tag>
# Only these identities, on top of whatever the Access policy admits. Recommended here:
# it keeps root-over-SSH control of the MiSTers to you even if the policy is widened.
#MCP_ALLOWED_EMAILS=you@example.com

# --- Play tracking in Home Assistant (the mcp-server-misterfpga-track service) -----------
# Home Assistant's Mosquitto broker. Create a Home Assistant user for it (Settings > People >
# Users, e.g. "misterfpga"); the Mosquitto add-on accepts Home Assistant users. This file is
# 0640 root:mcp-mister, so the password is readable by the service user only.
#MISTERFPGA_MQTT_HOST=homeassistant.local
#MISTERFPGA_MQTT_PORT=1883
#MISTERFPGA_MQTT_USER=misterfpga
#MISTERFPGA_MQTT_PASSWORD=change-me
# Topics: <prefix>/<mister>/now_playing, last_session, session, activity, status
#MISTERFPGA_MQTT_TOPIC_PREFIX=misterfpga
#MISTERFPGA_MQTT_DISCOVERY_PREFIX=homeassistant
# Sessions shorter than this aren't logged (accidental launches, quick peeks), as Batocera.
#MISTERFPGA_MIN_SESSION_SECONDS=60

# Optional
#MISTERFPGA_BACKUP_DIR=/mnt/backups/mister-saves   # overrides backup_dir in config.json
#MISTERFPGA_DRY_RUN=1        # read the MiSTers, change nothing
#MCP_SERVE_ARGS=--no-redact
