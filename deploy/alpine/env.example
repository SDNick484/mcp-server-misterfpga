# /etc/mcp-server-misterfpga/env: read by run.sh (root:mcp-mister, mode 0640).
# Plain KEY=value lines. The MiSTers, their SSH key and backup_dir are in
# /var/lib/mcp-server-misterfpga/config.json (written by `check`).

# Where to listen. This server is meant to stay on your LAN (docs/DESIGN.md §11):
# it can start an update that reboots a MiSTer, and its SSH key is root on them.
# 127.0.0.1 keeps it inside this LXC; remote.py refuses any other address unless
# Cloudflare Access is configured (CF_ACCESS_*), which this deployment doesn't use.
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8716
MCP_HTTP_PATH=/misterfpga/mcp

# Optional
#MISTERFPGA_BACKUP_DIR=/mnt/backups/mister-saves   # overrides backup_dir in config.json
#MISTERFPGA_DRY_RUN=1        # read the MiSTers, change nothing
#MCP_SERVE_ARGS=--no-redact
